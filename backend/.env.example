NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/psyscreening?schema=public"
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
REQUIRE_EMAIL_VERIFICATION=false
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Email sender. Recommended for production on Railway/Vercel: Resend HTTP API.
EMAIL_PROVIDER=resend
RESEND_API_KEY="your_resend_api_key"
MAIL_FROM="PsyScreening <onboarding@resend.dev>"

# Optional SMTP fallback. For Gmail, use an App Password, not your Gmail password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_gmail_address@gmail.com"
SMTP_PASS="your_gmail_app_password"

# Optional Mailtrap fallback for development.
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="your_mailtrap_username"
MAILTRAP_PASS="your_mailtrap_password"

GOOGLE_CLIENT_ID="your_google_client_id"

ADMIN_EMAIL=adminganteng@gmail.com
ADMIN_PASSWORD=your_admin_password_here

ML_PROVIDER=mock
ML_SERVICE_URL=
AI_ML_API_BASE_URL=https://fastapi-psyscreening-production.up.railway.app
