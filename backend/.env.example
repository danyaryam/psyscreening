# Development Configuration
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psyscreening?schema=public
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ML_PROVIDER=mock
ML_SERVICE_URL=

