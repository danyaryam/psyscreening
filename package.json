{
  "name": "psyscreening",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm run install:backend && npm run install:frontend",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "stop:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-psyscreening-dev.ps1",
    "predev": "npm run stop:dev",
    "dev:fresh": "npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "db:migrate": "npm --prefix backend run prisma:migrate -- --name init",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
